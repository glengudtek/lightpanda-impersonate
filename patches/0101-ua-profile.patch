+fn readUaProfileConfig(b: *Build, path: []const u8) UaProfileConfig {
+    const bytes = std.Io.Dir.cwd().readFileAllocOptions(
+        b.graph.io,
+        path,
+        b.allocator,
+        .limited(1024 * 1024),
+        .of(u8),
+        0,
+    ) catch |err| switch (err) {
+        error.FileNotFound => return .{},
+        else => |e| {
+            std.debug.panic("failed to read UA profile config '{s}': {s}", .{ path, @errorName(e) });
+        },
+    };
+
+    const source = b.allocator.dupeZ(u8, bytes) catch @panic("OOM");
+    var diagnostics: std.zon.parse.Diagnostics = .{};
+    defer diagnostics.deinit(b.allocator);
+    const config = std.zon.parse.fromSliceAlloc(UaProfileConfig, b.allocator, source, &diagnostics, .{}) catch |err| {
+        std.debug.panic("failed to load UA profile config '{s}': {s}", .{ path, @errorName(err) });
+    };
+    return config;
+}
+
+fn resolveUaProfileConfig(b: *Build, config: UaProfileConfig) ResolvedUaProfile {
+    const major = b.allocator.dupeZ(u8, majorVersion(config.full_version)) catch @panic("OOM");
+    const user_agent = config.user_agent orelse b.allocator.dupeZ(
+        u8,
+        b.fmt(
+            "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/{s}.0.0.0 Safari/537.36",
+            .{major},
+        ),
+    ) catch @panic("OOM");
+
+    if (config.manual_brands) |manual| {
+        return .{
+            .user_agent = user_agent,
+            .full_version = config.full_version,
+            .low_entropy_brands = normalizeBrandList(b, manual, false),
+            .high_entropy_brands = normalizeBrandList(b, manual, true),
+        };
+    }
+
+    const seed = std.fmt.parseInt(usize, major, 10) catch |err| {
+        std.debug.panic("UA profile full_version must start with a numeric major version: {s}", .{@errorName(err)});
+    };
+
+    return .{
+        .user_agent = user_agent,
+        .full_version = config.full_version,
+        .low_entropy_brands = generatedBrandList(b, seed, major, false, config.include_google_chrome_brand, config.additional_brands),
+        .high_entropy_brands = generatedBrandList(b, seed, config.full_version, true, config.include_google_chrome_brand, config.additional_brands),
+    };
+}
+
+fn majorVersion(version: [:0]const u8) []const u8 {
+    return version[0 .. std.mem.indexOfScalar(u8, version, '.') orelse version.len];
+}
+
+fn generatedBrandList(
+    b: *Build,
+    seed: usize,
+    version: [:0]const u8,
+    full_version: bool,
+    include_google_chrome_brand: bool,
+    additional_brands: []const UaBrand,
+) []const UaBrand {
+    const len = 2 + @as(usize, if (include_google_chrome_brand) 1 else 0) + additional_brands.len;
+    if (len < 2 or len > 4) {
+        std.debug.panic("UA profile brand list size must be between 2 and 4, got {}", .{len});
+    }
+
+    const input = b.allocator.alloc(UaBrand, len) catch @panic("OOM");
+    input[0] = greasedBrandVersion(b, seed, full_version);
+    input[1] = .{ .brand = "Chromium", .version = version };
+
+    var i: usize = 2;
+    if (include_google_chrome_brand) {
+        input[i] = .{ .brand = "Google Chrome", .version = version };
+        i += 1;
+    }
+    for (additional_brands) |brand| {
+        input[i] = normalizeBrand(b, brand, full_version);
+        i += 1;
+    }
+
+    return shuffleBrandList(b, seed, input);
+}
+
+fn normalizeBrandList(b: *Build, brands: []const UaBrand, full_version: bool) []const UaBrand {
+    const out = b.allocator.alloc(UaBrand, brands.len) catch @panic("OOM");
+    for (brands, out) |brand, *normalized| {
+        normalized.* = normalizeBrand(b, brand, full_version);
+    }
+    return out;
+}
+
+fn normalizeBrand(b: *Build, brand: UaBrand, full_version: bool) UaBrand {
+    if (full_version or std.mem.indexOfScalar(u8, brand.version, '.') == null) {
+        return brand;
+    }
+
+    return .{
+        .brand = brand.brand,
+        .version = b.allocator.dupeZ(u8, majorVersion(brand.version)) catch @panic("OOM"),
+    };
+}
+
+fn greasedBrandVersion(b: *Build, seed: usize, full_version: bool) UaBrand {
+    const greasey_chars = [_][]const u8{ " ", "(", ":", "-", ".", "/", ")", ";", "=", "?", "_" };
+    const greased_versions = [_][:0]const u8{ "8", "99", "24" };
+    const base_version = greased_versions[seed % greased_versions.len];
+    return .{
+        .brand = b.allocator.dupeZ(u8, b.fmt("Not{s}A{s}Brand", .{
+            greasey_chars[seed % greasey_chars.len],
+            greasey_chars[(seed + 1) % greasey_chars.len],
+        })) catch @panic("OOM"),
+        .version = if (full_version)
+            b.allocator.dupeZ(u8, b.fmt("{s}.0.0.0", .{base_version})) catch @panic("OOM")
+        else
+            base_version,
+    };
+}
+
+fn shuffleBrandList(b: *Build, seed: usize, input: []const UaBrand) []const UaBrand {
+    const order = randomOrder(b, seed, input.len);
+    const out = b.allocator.alloc(UaBrand, input.len) catch @panic("OOM");
+    for (input, order) |brand, index| {
+        out[index] = brand;
+    }
+    return out;
+}
+
+fn randomOrder(b: *Build, seed: usize, size: usize) []const usize {
+    if (size < 2 or size > 4) {
+        std.debug.panic("UA profile brand order size must be between 2 and 4, got {}", .{size});
+    }
+
+    var order_index = seed % factorial(size);
+    const remaining = b.allocator.alloc(usize, size) catch @panic("OOM");
+    const order = b.allocator.alloc(usize, size) catch @panic("OOM");
+    for (remaining, 0..) |*slot, i| {
+        slot.* = i;
+    }
+
+    var remaining_len = size;
+    for (order) |*slot| {
+        const block_size = factorial(remaining_len - 1);
+        const selected = order_index / block_size;
+        order_index %= block_size;
+        slot.* = remaining[selected];
+        std.mem.copyForwards(usize, remaining[selected..], remaining[selected + 1 .. remaining_len]);
+        remaining_len -= 1;
+    }
+    return order;
+}
+
+fn factorial(n: usize) usize {
+    if (n < 2) {
+        return 1;
+    }
+
+    var out: usize = 1;
+    for (2..n + 1) |i| {
+        out *= i;
+    }
+    return out;
+}
+
+fn uaProfileBrandNames(b: *Build, brands: []const UaBrand) []const [:0]const u8 {
+    const names = b.allocator.alloc([:0]const u8, brands.len) catch @panic("OOM");
+    for (brands, names) |brand, *name| {
+        name.* = brand.brand;
+    }
+    return names;
+}
+
+fn uaProfileBrandVersions(b: *Build, brands: []const UaBrand) []const [:0]const u8 {
+    const versions = b.allocator.alloc([:0]const u8, brands.len) catch @panic("OOM");
+    for (brands, versions) |brand, *version| {
+        version.* = brand.version;
+    }
+    return versions;
+}
