diff --git a/src/network/curl_impersonate.zig b/src/network/curl_impersonate.zig
new file mode 100644
index 000000000..d8336f21f
--- /dev/null
+++ b/src/network/curl_impersonate.zig
@@ -0,0 +1,19 @@
+const libcurl = @import("../sys/libcurl.zig");
+
+extern fn curl_easy_impersonate(
+    easy: *libcurl.Curl,
+    target: [*]const u8,
+    default_headers: c_int,
+) libcurl.CurlCode;
+
+const Error = error{
+    EmptyCurlImpersonateProfile,
+    CurlImpersonateFailed,
+};
+
+pub fn apply(easy: *libcurl.Curl, profile: [:0]const u8) Error!void {
+    if (profile.len == 0) return error.EmptyCurlImpersonateProfile;
+    if (curl_easy_impersonate(easy, profile.ptr, 0) != libcurl.CURLE.OK) {
+        return error.CurlImpersonateFailed;
+    }
+}
